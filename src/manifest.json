{
  "manifest_version": 3,
  "name": "Suvidha Booking Assistant",
  "version": "1.2.0",
  "description": "Suvidha Exporter Booking Assistant by Ayub Ansari",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://suvidha-mp.wb.gov.in/*",
    "https://wbifms.gov.in/*",
    "https://epay.sbi.bank.in/*",
    "https://*.sbiepay.sbi/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://suvidha-mp.wb.gov.in/exporter-oth/*",
        "https://wbifms.gov.in/GRIPS/*",
        "https://epay.sbi.bank.in/*",
        "https://*.sbiepay.sbi/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
