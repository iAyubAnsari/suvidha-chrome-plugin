{
  "manifest_version": 3,
  "name": "Suvidha Booking Assistant",
  "version": "1.1.0",
  "description": "Exporter booking form assistant by Ayub Ansari",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://suvidha-mp.wb.gov.in/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://suvidha-mp.wb.gov.in/exporter-oth/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}