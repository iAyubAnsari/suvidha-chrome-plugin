{
  "manifest_version": 3,
  "name": "Suvidha Booking Assistant",
  "version": "1.1.0",
  "description": "Exporter booking form assistant by Ayub Ansari",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://suvidha-mp.wb.gov.in/*",
    "https://wbifms.gov.in/*",
    "https://epay.sbi.bank.in/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://suvidha-mp.wb.gov.in/exporter-oth/*",
        "https://wbifms.gov.in/GRIPS/*",
        "https://epay.sbi.bank.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "node_modules/tesseract.js/dist/tesseract.min.js",
        "tessdata/eng.traineddata",
        "tesseract-worker.min.js",
        "tesseract-core-simd-lstm.wasm.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}